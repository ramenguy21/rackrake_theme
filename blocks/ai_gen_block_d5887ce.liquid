{% doc %}
  @prompt
    I want a huge hero banner that says a huge title like BUY and sell clothes and then a two tab buttons below it a user can switch between for information, i can choose which one is preemptively chosen either buy or sell, and then the information below it changes accourding the button chosen. there are three boxes of information in a unique aestehtic way 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-tabs-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-hero-tabs__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-hero-tabs__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    text-align: center;
    margin: 0 0 {{ block.settings.title_spacing }}px;
    line-height: 1;
    text-transform: uppercase;
    font-weight: 700;
  }

  .ai-hero-tabs__tab-buttons-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: {{ block.settings.tab_gap }}px;
    margin-bottom: {{ block.settings.content_spacing }}px;
  }

  .ai-hero-tabs__tab-button-{{ ai_gen_id }} {
    padding: {{ block.settings.tab_padding_vertical }}px {{ block.settings.tab_padding_horizontal }}px;
    background-color: {{ block.settings.tab_inactive_bg }};
    color: {{ block.settings.tab_inactive_text }};
    border: {{ block.settings.tab_border_width }}px solid {{ block.settings.tab_inactive_border }};
    cursor: pointer;
    font-size: {{ block.settings.tab_font_size }}px;
    font-weight: 600;
    text-transform: uppercase;
    transition: all 0.3s ease;
    border-radius: {{ block.settings.tab_border_radius }}px;
  }

  .ai-hero-tabs__tab-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.tab_hover_bg }};
    color: {{ block.settings.tab_hover_text }};
    border-color: {{ block.settings.tab_hover_border }};
  }

  .ai-hero-tabs__tab-button-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.tab_active_bg }};
    color: {{ block.settings.tab_active_text }};
    border-color: {{ block.settings.tab_active_border }};
  }

  .ai-hero-tabs__content-{{ ai_gen_id }} {
    display: none;
  }

  .ai-hero-tabs__content-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-hero-tabs__boxes-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.box_gap }}px;
  }

  .ai-hero-tabs__box-{{ ai_gen_id }} {
    background-color: {{ block.settings.box_bg_color }};
    border: {{ block.settings.box_border_width }}px solid {{ block.settings.box_border_color }};
    padding: {{ block.settings.box_padding }}px;
    border-radius: {{ block.settings.box_border_radius }}px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-hero-tabs__box-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
  }

  .ai-hero-tabs__box-icon-{{ ai_gen_id }} {
    font-size: {{ block.settings.box_icon_size }}px;
    margin-bottom: {{ block.settings.box_icon_spacing }}px;
  }

  .ai-hero-tabs__box-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.box_title_size }}px;
    color: {{ block.settings.box_title_color }};
    margin: 0 0 {{ block.settings.box_title_spacing }}px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .ai-hero-tabs__box-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.box_text_size }}px;
    color: {{ block.settings.box_text_color }};
    line-height: 1.5;
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .ai-hero-tabs__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.6);
    }

    .ai-hero-tabs__tab-buttons-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 12px;
    }

    .ai-hero-tabs__boxes-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-hero-tabs__box-{{ ai_gen_id }} {
      padding: 20px;
    }
  }
{% endstyle %}

<hero-tabs-{{ ai_gen_id }} class="ai-hero-tabs-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-tabs__container-{{ ai_gen_id }}">
    <h1 class="ai-hero-tabs__title-{{ ai_gen_id }}">{{ block.settings.main_title }}</h1>

    <div class="ai-hero-tabs__tab-buttons-{{ ai_gen_id }}">
      <button
        class="ai-hero-tabs__tab-button-{{ ai_gen_id }} {% if block.settings.default_tab == 'buy' %}active{% endif %}"
        data-tab="buy"
        aria-label="Show buy information"
      >
        {{ block.settings.buy_tab_label }}
      </button>
      <button
        class="ai-hero-tabs__tab-button-{{ ai_gen_id }} {% if block.settings.default_tab == 'sell' %}active{% endif %}"
        data-tab="sell"
        aria-label="Show sell information"
      >
        {{ block.settings.sell_tab_label }}
      </button>
    </div>

    <div
      class="ai-hero-tabs__content-{{ ai_gen_id }} {% if block.settings.default_tab == 'buy' %}active{% endif %}"
      data-content="buy"
    >
      <div class="ai-hero-tabs__boxes-{{ ai_gen_id }}">
        <div class="ai-hero-tabs__box-{{ ai_gen_id }}">
          <div class="ai-hero-tabs__box-icon-{{ ai_gen_id }}">{{ block.settings.buy_box_1_icon }}</div>
          <h3 class="ai-hero-tabs__box-title-{{ ai_gen_id }}">{{ block.settings.buy_box_1_title }}</h3>
          <p class="ai-hero-tabs__box-text-{{ ai_gen_id }}">{{ block.settings.buy_box_1_text }}</p>
        </div>
        <div class="ai-hero-tabs__box-{{ ai_gen_id }}">
          <div class="ai-hero-tabs__box-icon-{{ ai_gen_id }}">{{ block.settings.buy_box_2_icon }}</div>
          <h3 class="ai-hero-tabs__box-title-{{ ai_gen_id }}">{{ block.settings.buy_box_2_title }}</h3>
          <p class="ai-hero-tabs__box-text-{{ ai_gen_id }}">{{ block.settings.buy_box_2_text }}</p>
        </div>
        <div class="ai-hero-tabs__box-{{ ai_gen_id }}">
          <div class="ai-hero-tabs__box-icon-{{ ai_gen_id }}">{{ block.settings.buy_box_3_icon }}</div>
          <h3 class="ai-hero-tabs__box-title-{{ ai_gen_id }}">{{ block.settings.buy_box_3_title }}</h3>
          <p class="ai-hero-tabs__box-text-{{ ai_gen_id }}">{{ block.settings.buy_box_3_text }}</p>
        </div>
      </div>
    </div>

    <div
      class="ai-hero-tabs__content-{{ ai_gen_id }} {% if block.settings.default_tab == 'sell' %}active{% endif %}"
      data-content="sell"
    >
      <div class="ai-hero-tabs__boxes-{{ ai_gen_id }}">
        <div class="ai-hero-tabs__box-{{ ai_gen_id }}">
          <div class="ai-hero-tabs__box-icon-{{ ai_gen_id }}">{{ block.settings.sell_box_1_icon }}</div>
          <h3 class="ai-hero-tabs__box-title-{{ ai_gen_id }}">{{ block.settings.sell_box_1_title }}</h3>
          <p class="ai-hero-tabs__box-text-{{ ai_gen_id }}">{{ block.settings.sell_box_1_text }}</p>
        </div>
        <div class="ai-hero-tabs__box-{{ ai_gen_id }}">
          <div class="ai-hero-tabs__box-icon-{{ ai_gen_id }}">{{ block.settings.sell_box_2_icon }}</div>
          <h3 class="ai-hero-tabs__box-title-{{ ai_gen_id }}">{{ block.settings.sell_box_2_title }}</h3>
          <p class="ai-hero-tabs__box-text-{{ ai_gen_id }}">{{ block.settings.sell_box_2_text }}</p>
        </div>
        <div class="ai-hero-tabs__box-{{ ai_gen_id }}">
          <div class="ai-hero-tabs__box-icon-{{ ai_gen_id }}">{{ block.settings.sell_box_3_icon }}</div>
          <h3 class="ai-hero-tabs__box-title-{{ ai_gen_id }}">{{ block.settings.sell_box_3_title }}</h3>
          <p class="ai-hero-tabs__box-text-{{ ai_gen_id }}">{{ block.settings.sell_box_3_text }}</p>
        </div>
      </div>
    </div>
  </div>
</hero-tabs-{{ ai_gen_id }}>

<script>
  (function() {
    class HeroTabs{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.tabButtons = this.querySelectorAll('.ai-hero-tabs__tab-button-{{ ai_gen_id }}');
        this.tabContents = this.querySelectorAll('.ai-hero-tabs__content-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.tabButtons.forEach((button) => {
          button.addEventListener('click', () => {
            const tabName = button.getAttribute('data-tab');
            this.switchTab(tabName);
          });
        });
      }

      switchTab(tabName) {
        this.tabButtons.forEach((btn) => {
          if (btn.getAttribute('data-tab') === tabName) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });

        this.tabContents.forEach((content) => {
          if (content.getAttribute('data-content') === tabName) {
            content.classList.add('active');
          } else {
            content.classList.remove('active');
          }
        });
      }
    }

    customElements.define('hero-tabs-{{ ai_gen_id }}', HeroTabs{{ ai_gen_id }});
  })();
</script>

