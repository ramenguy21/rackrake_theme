{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-shop-info-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-shop-info__container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    padding: {{ block.settings.vertical_padding }}px 0;
  }

  .ai-shop-info__location-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 4px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
  }

  .ai-shop-info__pin-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
  }

  .ai-shop-info__rating-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    text-decoration: none;
    transition: opacity 0.2s ease;
    background: none;
    border: none;
    padding: 0;
  }

  .ai-shop-info__rating-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-shop-info__star-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    color: {{ block.settings.star_color }};
  }

  .ai-shop-info__star-icon-{{ ai_gen_id }}.empty {
    color: #cccccc;
  }

  .ai-shop-info__popup-overlay-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .ai-shop-info__popup-overlay-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-shop-info__popup-{{ ai_gen_id }} {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.9);
    width: 90%;
    max-width: 800px;
    max-height: 90vh;
    background-color: #ffffff;
    border-radius: 8px;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease, transform 0.3s ease;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .ai-shop-info__popup-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
  }

  .ai-shop-info__popup-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    border-bottom: 1px solid #e0e0e0;
  }

  .ai-shop-info__popup-title-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 600;
    margin: 0;
  }

  .ai-shop-info__popup-close-{{ ai_gen_id }} {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #666;
    transition: color 0.2s ease;
  }

  .ai-shop-info__popup-close-{{ ai_gen_id }}:hover {
    color: #000;
  }

  .ai-shop-info__popup-content-{{ ai_gen_id }} {
    padding: 20px;
    overflow-y: auto;
    flex-grow: 1;
  }

  .ai-shop-info__popup-iframe-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    min-height: 400px;
    border: none;
  }

  .ai-shop-info__empty-state-{{ ai_gen_id }} {
    text-align: center;
    color: #999;
    padding: 40px 20px;
    font-size: 14px;
  }
{% endstyle %}

<shop-info-{{ ai_gen_id }} class="ai-shop-info-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-shop-info__container-{{ ai_gen_id }}">
    {% if block.settings.location_text != blank %}
      <div class="ai-shop-info__location-{{ ai_gen_id }}">
        <svg class="ai-shop-info__pin-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>{{ block.settings.location_text }}</span>
      </div>
    {% endif %}

    {% if block.settings.show_rating %}
      {% liquid
        assign has_rating = false
        if block.settings.rating_value != blank and block.settings.rating_value != '0' and block.settings.rating_value != 0
          assign has_rating = true
        endif
      %}

      <button class="ai-shop-info__rating-{{ ai_gen_id }}" type="button" aria-label="View ratings">
        <svg class="ai-shop-info__star-icon-{{ ai_gen_id }} {% unless has_rating %}empty{% endunless %}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
        </svg>
        {% if has_rating %}
          <span>{{ block.settings.rating_value }}{% if block.settings.rating_text != blank %} {{ block.settings.rating_text }}{% endif %}</span>
        {% else %}
          <span>No ratings yet</span>
        {% endif %}
      </button>
    {% endif %}
  </div>

  {% if block.settings.show_rating %}
    <div class="ai-shop-info__popup-overlay-{{ ai_gen_id }}"></div>
    
    <div class="ai-shop-info__popup-{{ ai_gen_id }}">
      <div class="ai-shop-info__popup-header-{{ ai_gen_id }}">
        <h3 class="ai-shop-info__popup-title-{{ ai_gen_id }}">{{ block.settings.popup_title }}</h3>
        <button class="ai-shop-info__popup-close-{{ ai_gen_id }}" type="button" aria-label="Close">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="ai-shop-info__popup-content-{{ ai_gen_id }}">
        {% if block.settings.popup_page != blank %}
          <iframe 
            class="ai-shop-info__popup-iframe-{{ ai_gen_id }}"
            src="{{ block.settings.popup_page.url }}"
            title="{{ block.settings.popup_title }}"
          ></iframe>
        {% else %}
          <div class="ai-shop-info__empty-state-{{ ai_gen_id }}">No ratings yet</div>
        {% endif %}
      </div>
    </div>
  {% endif %}
</shop-info-{{ ai_gen_id }}>

<script>
  (function() {
    class ShopInfo{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.ratingButton = this.querySelector('.ai-shop-info__rating-{{ ai_gen_id }}');
        this.popup = this.querySelector('.ai-shop-info__popup-{{ ai_gen_id }}');
        this.overlay = this.querySelector('.ai-shop-info__popup-overlay-{{ ai_gen_id }}');
        this.closeButton = this.querySelector('.ai-shop-info__popup-close-{{ ai_gen_id }}');

        if (this.ratingButton) {
          this.ratingButton.addEventListener('click', () => this.openPopup());
        }

        if (this.closeButton) {
          this.closeButton.addEventListener('click', () => this.closePopup());
        }

        if (this.overlay) {
          this.overlay.addEventListener('click', () => this.closePopup());
        }

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.popup && this.popup.classList.contains('active')) {
            this.closePopup();
          }
        });
      }

      openPopup() {
        if (this.popup && this.overlay) {
          this.popup.classList.add('active');
          this.overlay.classList.add('active');
          document.body.style.overflow = 'hidden';
        }
      }

      closePopup() {
        if (this.popup && this.overlay) {
          this.popup.classList.remove('active');
          this.overlay.classList.remove('active');
          document.body.style.overflow = '';
        }
      }
    }

    customElements.define('shop-info-{{ ai_gen_id }}', ShopInfo{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Shop location and rating",
  "settings": [
    {
      "type": "header",
      "content": "Location"
    },
    {
      "type": "text",
      "id": "location_text",
      "label": "Location text",
      "default": "Based in Karachi"
    },
    {
      "type": "header",
      "content": "Rating"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": false
    },
    {
      "type": "text",
      "id": "rating_value",
      "label": "Rating value"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text"
    },
    {
      "type": "page",
      "id": "popup_page",
      "label": "Popup page"
    },
    {
      "type": "text",
      "id": "popup_title",
      "label": "Popup title",
      "default": "Shop Ratings"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#FFB800"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Shop location and rating"
    }
  ]
}
{% endschema %}
