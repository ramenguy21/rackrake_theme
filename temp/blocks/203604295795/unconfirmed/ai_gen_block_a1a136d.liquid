{% doc %}
  @prompt
    i want a search bar for the entire shop here
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-search-bar-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-search-bar__container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-search-bar__form-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
  }

  .ai-search-bar__input-wrapper-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    align-items: center;
    background-color: {{ block.settings.background_color }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .ai-search-bar__input-wrapper-{{ ai_gen_id }}:focus-within {
    border-color: {{ block.settings.focus_border_color }};
  }

  .ai-search-bar__icon-{{ ai_gen_id }} {
    position: absolute;
    left: {{ block.settings.padding_horizontal }}px;
    top: 50%;
    transform: translateY(-50%);
    color: {{ block.settings.icon_color }};
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-search-bar__icon-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
  }

  .ai-search-bar__input-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    padding-left: calc({{ block.settings.padding_horizontal }}px + {{ block.settings.icon_size }}px + 12px);
    padding-right: calc({{ block.settings.padding_horizontal }}px + 40px);
    border: none;
    background: transparent;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    outline: none;
  }

  .ai-search-bar__input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.placeholder_color }};
  }

  .ai-search-bar__clear-{{ ai_gen_id }} {
    position: absolute;
    right: {{ block.settings.padding_horizontal }}px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    padding: 4px;
    cursor: pointer;
    color: {{ block.settings.icon_color }};
    display: none;
    align-items: center;
    justify-content: center;
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  .ai-search-bar__clear-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-search-bar__clear-{{ ai_gen_id }}.active {
    display: flex;
  }

  .ai-search-bar__clear-{{ ai_gen_id }} svg {
    width: 18px;
    height: 18px;
  }

  @media screen and (max-width: 749px) {
    .ai-search-bar-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-search-bar__input-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<search-bar-{{ ai_gen_id }}
  class="ai-search-bar-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-search-bar__container-{{ ai_gen_id }}">
    <form
      action="{{ routes.search_url }}"
      method="get"
      role="search"
      class="ai-search-bar__form-{{ ai_gen_id }}"
    >
      <div class="ai-search-bar__input-wrapper-{{ ai_gen_id }}">
        <div class="ai-search-bar__icon-{{ ai_gen_id }}">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
        </div>
        <input
          type="search"
          name="q"
          class="ai-search-bar__input-{{ ai_gen_id }}"
          placeholder="{{ block.settings.placeholder_text }}"
          aria-label="Search"
          autocomplete="off"
        >
        <button
          type="button"
          class="ai-search-bar__clear-{{ ai_gen_id }}"
          aria-label="Clear search"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </form>
  </div>
</search-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class SearchBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.input = this.querySelector('.ai-search-bar__input-{{ ai_gen_id }}');
        this.clearButton = this.querySelector('.ai-search-bar__clear-{{ ai_gen_id }}');
        
        if (this.input && this.clearButton) {
          this.setupEventListeners();
          this.updateClearButton();
        }
      }

      setupEventListeners() {
        this.input.addEventListener('input', () => {
          this.updateClearButton();
        });

        this.clearButton.addEventListener('click', () => {
          this.input.value = '';
          this.updateClearButton();
          this.input.focus();
        });
      }

      updateClearButton() {
        if (this.input.value.length > 0) {
          this.clearButton.classList.add('active');
        } else {
          this.clearButton.classList.remove('active');
        }
      }
    }

    customElements.define('search-bar-{{ ai_gen_id }}', SearchBar{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Search bar",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Placeholder text",
      "default": "Search products..."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Placeholder",
      "default": "#999999"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "focus_border_color",
      "label": "Focus border",
      "default": "#c15045"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Search bar"
    }
  ]
}
{% endschema %}
